# Start room in the committed/public topology export.
string start_room_id
# Goal room in the committed/public topology export.
string goal_room_id
# Optional route policy token; empty maps to the default balanced policy.
string route_policy
---
# `success=false` indicates a malformed request or invalid node configuration.
bool success
# Empty when the wrapper-level request succeeded.
string error_code
# JSON payload string carrying the current thin query-layer response body.
string json_response
