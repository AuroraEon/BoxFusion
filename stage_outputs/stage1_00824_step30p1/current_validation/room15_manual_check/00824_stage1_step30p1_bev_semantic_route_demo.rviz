Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: BEV Grid
      Enabled: true
      Cell Size: 1
      Plane: XY
      Reference Frame: map
    - Class: rviz_default_plugins/Map
      Name: Nav2 Occupancy Free-Space Map
      Enabled: true
      Topic:
        Value: /map
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Alpha: 0.92
      Color Scheme: map
      Draw Behind: true
      Update Topic: ""
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Frame Timeout: 15
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Marker Scale: 0.5
    - Class: rviz_default_plugins/RobotModel
      Name: TurtleBot3 Robot Model
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/LaserScan
      Name: Laser Scan
      Enabled: true
      Topic:
        Value: /scan
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
      Size (m): 0.03
      Style: Points
    - Class: rviz_default_plugins/MarkerArray
      Name: Stage1 Semantic Room Route Trajectory Overlay
      Enabled: true
      Topic:
        Value: /stage1_nav/semantic_overlay_markers
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/Path
      Name: Nav2 Global Plan
      Enabled: true
      Topic:
        Value: /plan
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 0; 255
      Alpha: 1.0
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
    - Class: rviz_default_plugins/Path
      Name: Nav2 Local Plan
      Enabled: true
      Topic:
        Value: /local_plan
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
      Color: 255; 180; 0
      Alpha: 1.0
      Buffer Length: 1
      Line Style: Lines
      Line Width: 0.04
  Enabled: true
  Global Options:
    Background Color: 18; 18; 18
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic:
        Value: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic:
        Value: /goal_pose
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: BEV Top Down
      Target Frame: map
      Scale: 18
      X: 0
      Y: -1
    Saved: ~
Window Geometry:
  Height: 980
  Width: 1400
  X: 60
  Y: 40
