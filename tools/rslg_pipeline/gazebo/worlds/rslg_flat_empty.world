<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="rslg_flat_empty">
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6.0e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <include>
      <uri>model://sun</uri>
    </include>

    <model name="rslg_same_floor_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>24 18 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>24 18 0.02</size>
            </box>
          </geometry>
          <material>
            <ambient>0.78 0.80 0.82 1</ambient>
            <diffuse>0.78 0.80 0.82 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.01 0 0 0</pose>
    </model>

    <include>
      <uri>model://rslg_diff_drive</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>
  </world>
</sdf>
