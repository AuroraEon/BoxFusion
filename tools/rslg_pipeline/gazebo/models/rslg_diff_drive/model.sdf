<?xml version="1.0" ?>
<sdf version="1.6">
  <model name="rslg_diff_drive">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint"/>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.10 0 0 0</pose>
        <mass>1.8</mass>
        <inertia>
          <ixx>0.02</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.02</iyy>
          <iyz>0.0</iyz>
          <izz>0.03</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.24 0.14</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry>
          <box>
            <size>0.32 0.24 0.14</size>
          </box>
        </geometry>
        <material>
          <ambient>0.12 0.24 0.32 1</ambient>
          <diffuse>0.12 0.42 0.55 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="base_footprint_joint" type="fixed">
      <parent>base_footprint</parent>
      <child>base_link</child>
    </joint>

    <link name="left_wheel">
      <inertial>
        <pose>0 0.15 0.05 -1.570796 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0.0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0.15 0.05 -1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e5</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 0.15 0.05 -1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="right_wheel">
      <inertial>
        <pose>0 -0.15 0.05 -1.570796 0 0</pose>
        <mass>0.25</mass>
        <inertia>
          <ixx>0.0004</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.0004</iyy>
          <iyz>0.0</iyz>
          <izz>0.0004</izz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 -0.15 0.05 -1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>100000.0</mu>
              <mu2>100000.0</mu2>
              <fdir1>0 0 0</fdir1>
              <slip1>0.0</slip1>
              <slip2>0.0</slip2>
            </ode>
          </friction>
          <contact>
            <ode>
              <soft_cfm>0</soft_cfm>
              <soft_erp>0.2</soft_erp>
              <kp>1e5</kp>
              <kd>1</kd>
              <max_vel>0.01</max_vel>
              <min_depth>0.001</min_depth>
            </ode>
          </contact>
        </surface>
      </collision>
      <visual name="visual">
        <pose>0 -0.15 0.05 -1.570796 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.035</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>
    </link>

    <link name="caster">
      <collision name="collision">
        <pose>-0.13 0 0.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
      </collision>
      <visual name="visual">
        <pose>-0.13 0 0.025 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.05 0.05 0.05 1</diffuse>
        </material>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <pose>0 0.15 0.05 -1.570796 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <pose>0 -0.15 0.05 -1.570796 0 0</pose>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="caster_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <plugin name="rslg_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <remapping>cmd_vel:=/cmd_vel</remapping>
        <remapping>odom:=/odom</remapping>
      </ros>
      <update_rate>50.0</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.30</wheel_separation>
      <wheel_diameter>0.10</wheel_diameter>
      <max_wheel_torque>20.0</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>/cmd_vel</command_topic>
      <odometry_topic>/odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
    </plugin>
  </model>
</sdf>
