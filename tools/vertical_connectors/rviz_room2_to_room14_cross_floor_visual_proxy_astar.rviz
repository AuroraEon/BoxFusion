Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 150; 150; 150
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World Grid
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.6
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Name: TF
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Visual Proxy Odom
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 1200
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_visual_proxy/odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planned Occupancy-Aware 3D Route
      Namespaces:
        planned_3d_route: true
        connector_centerline: true
        semantic_checkpoints: true
        checkpoint_labels: true
        transition_edge: true
        claim_boundary: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_planned_route
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Executed Occupancy-Aware Trajectory
      Namespaces:
        executed_3d_trajectory: true
        current_visual_proxy_pose: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_executed_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Visual Proxy Markers
      Namespaces:
        visual_proxy_body: true
        visual_proxy_label: true
        visual_proxy_claim: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_visual_proxy_markers
      Value: true
  Enabled: true
  Global Options:
    Background Color: 248; 248; 246
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: -5.4
        Y: 3.0
        Z: 3.3
      Name: Oblique Cross-Floor View
      Pitch: 0.62
      Target Frame: <Fixed Frame>
      Yaw: 0.75
    Saved: ~
Window Geometry:
  Height: 920
  Width: 1320
