Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.45
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 150; 150; 150
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: World Grid
      Plane: XY
      Plane Cell Count: 24
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.6
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Name: TF
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: Object Tracking Proxy Odom
      Position Tolerance: 0.1
      Angle Tolerance: 0.1
      Keep: 1800
      Shape: Arrow
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking/odom
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Planned Object-Level Route
      Namespaces:
        planned_astar_and_stair_route: true
        stair_connector_2p5d_centerline: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_planned_route
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Executed Object Tracking Trajectory
      Namespaces:
        integrated_executed_tracking_trajectory: true
        current_integrated_actual_pose: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_executed_trajectory
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Object Tracking Error
      Namespaces:
        sparse_tracking_error_segments: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_error_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Object Tracking Checkpoints
      Namespaces:
        tracking_semantic_checkpoints: true
        tracking_checkpoint_labels: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_checkpoints
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Obj175 Target And Approach
      Namespaces:
        obj175_target_marker: true
        obj175_target_label: true
        obj175_approach_generated_ring_037: true
        obj175_approach_label: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_target
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Object Tracking Claim Boundary
      Namespaces:
        object_tracking_claim_boundary: true
      Queue Size: 10
      Topic:
        Depth: 10
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rslg/cross_floor_object_tracking_claim_boundary
      Value: true
  Enabled: true
  Global Options:
    Background Color: 248; 248; 246
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 14
      Focal Point:
        X: -6.5
        Y: 2.4
        Z: 3.8
      Name: Current View
      Pitch: 0.55
      Target Frame: <Fixed Frame>
      Yaw: 4.95
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 60
  Y: 40
