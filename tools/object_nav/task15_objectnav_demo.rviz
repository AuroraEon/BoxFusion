Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views

Visualization Manager:
  Class: ""
  Enabled: true
  Global Options:
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Map
      Enabled: true
      Name: Nav2 Stable Occupancy Map
      Topic:
        Value: /map
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
      Alpha: 0.72
      Color Scheme: map
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: TurtleBot3 RobotModel
      Description Topic:
        Value: /robot_description
      TF Prefix: ""
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ObjectNav Pipeline Evidence
      Topic:
        Value: /task15/object_nav_markers
        Depth: 10
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Name: root
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: task15 object nav
      Target Frame: map
      Scale: 18
      X: -5.0
      Y: 3.0
      Angle: 0

Window Geometry:
  Height: 960
  Width: 1500
