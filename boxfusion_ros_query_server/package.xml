<?xml version="1.0"?>
<package format="3">
  <name>boxfusion_ros_query_server</name>
  <version>0.0.1</version>
  <description>ROS 2 Python node package for the thin committed/public query server plus debug-only publication diagnostics.</description>

  <maintainer email="maintainer@example.com">BoxFusion Maintainers</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>ros_interfaces</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-networkx</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
