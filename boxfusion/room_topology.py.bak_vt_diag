import json
import math
from dataclasses import dataclass, field
from itertools import islice
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Sequence, Set, Tuple

import networkx as nx
import numpy as np

from boxfusion.scene_graph_builder import normalize_open_vocab_label


TOPOLOGY_VERSION = "0.1"

DEFAULT_EVIDENCE_WEIGHTS: Dict[str, float] = {
    "trajectory_transition": 0.45,
    "boundary_contact": 0.25,
    "repeated_crossing": 0.20,
    "shared_frontier": 0.15,
    "door_detection": 0.60,
    "vertical_transition_observation": 0.65,
}

DEFAULT_STATUS_THRESHOLDS: Dict[str, float] = {
    "supported": 0.35,
    "confirmed": 0.65,
}

DEFAULT_ROUTE_RELATION_COSTS: Dict[str, float] = {
    "transition": 1.0,
    "adjacent": 1.6,
    "possible_connection": 2.4,
    "vertical_transition": 1.2,
}

DEFAULT_TOPOLOGY_CONFIG: Dict[str, Any] = {
    "adjacency_distance_m": 0.45,
    "possible_connection_distance_m": 1.10,
    "room_switch_jitter_tolerance": 1,
    "room_switch_min_segment_len": 1,
    "max_route_confidence_penalty": 0.75,
}


def _round_float(value: Any, digits: int = 3) -> Optional[float]:
    if value is None:
        return None
    return round(float(value), digits)


def _clamp01(value: float) -> float:
    return max(0.0, min(1.0, float(value)))


def _status_from_confidence(confidence: float, thresholds: Dict[str, float]) -> str:
    confidence = float(confidence)
    if confidence >= float(thresholds["confirmed"]):
        return "confirmed"
    if confidence >= float(thresholds["supported"]):
        return "supported"
    return "weak"


def _canonical_room_id(value: Any) -> Optional[str]:
    if value is None:
        return None
    if isinstance(value, str):
        token = value.strip()
        if not token:
            return None
        if token.startswith("room_"):
            suffix = token[5:]
            if suffix.lstrip("-").isdigit():
                if int(suffix) < 0:
                    return None
            return token
        if token.lstrip("-").isdigit():
            room_uuid = int(token)
            if room_uuid < 0:
                return None
            return f"room_{room_uuid}"
        return token
    room_uuid = int(value)
    if room_uuid < 0:
        return None
    return f"room_{room_uuid}"


def _room_uuid(room_id: Any) -> Optional[int]:
    canonical = _canonical_room_id(room_id)
    if canonical is None:
        return None
    suffix = canonical.split("room_", 1)[-1]
    if suffix.lstrip("-").isdigit():
        return int(suffix)
    return None


def _canonical_object_id(value: Any) -> Optional[str]:
    if value is None:
        return None
    if isinstance(value, str):
        token = value.strip()
        if not token:
            return None
        if token.startswith("obj_"):
            suffix = token[4:]
            if suffix.lstrip("-").isdigit() and int(suffix) < 0:
                return None
            return token
        if token.lstrip("-").isdigit():
            object_uuid = int(token)
            if object_uuid < 0:
                return None
            return f"obj_{object_uuid}"
        return token
    object_uuid = int(value)
    if object_uuid < 0:
        return None
    return f"obj_{object_uuid}"


def _canonical_anchor_id(value: Any) -> Optional[str]:
    if value is None:
        return None
    token = str(value).strip()
    if not token:
        return None
    if token.lstrip("-").isdigit():
        anchor_uuid = int(token)
        if anchor_uuid < 0:
            return None
        return f"anchor_{anchor_uuid}"
    return token


def _clean_optional_text(value: Any) -> Optional[str]:
    if value is None:
        return None
    text = str(value).strip()
    return text or None


def _polygon_area(polygon: Sequence[Sequence[float]]) -> float:
    if len(polygon) < 3:
        return 0.0
    pts = np.asarray(polygon, dtype=np.float32)
    x = pts[:, 0]
    y = pts[:, 1]
    return abs(0.5 * float(np.dot(x, np.roll(y, -1)) - np.dot(y, np.roll(x, -1))))


def _polygon_centroid(polygon: Sequence[Sequence[float]]) -> Tuple[float, float]:
    pts = np.asarray(polygon, dtype=np.float32)
    if len(pts) == 0:
        return (0.0, 0.0)
    if len(pts) < 3:
        return float(np.mean(pts[:, 0])), float(np.mean(pts[:, 1]))
    signed_area = 0.5 * float(
        np.dot(pts[:, 0], np.roll(pts[:, 1], -1)) - np.dot(pts[:, 1], np.roll(pts[:, 0], -1))
    )
    if abs(signed_area) < 1e-6:
        return float(np.mean(pts[:, 0])), float(np.mean(pts[:, 1]))
    cross = pts[:, 0] * np.roll(pts[:, 1], -1) - np.roll(pts[:, 0], -1) * pts[:, 1]
    scale = 1.0 / (6.0 * signed_area)
    cx = scale * np.sum((pts[:, 0] + np.roll(pts[:, 0], -1)) * cross)
    cy = scale * np.sum((pts[:, 1] + np.roll(pts[:, 1], -1)) * cross)
    return float(cx), float(cy)


def _bbox(polygon: Sequence[Sequence[float]]) -> Optional[Tuple[float, float, float, float]]:
    if not polygon:
        return None
    xs = [float(pt[0]) for pt in polygon]
    ys = [float(pt[1]) for pt in polygon]
    return min(xs), min(ys), max(xs), max(ys)


def _bbox_gap(box_a: Optional[Tuple[float, float, float, float]], box_b: Optional[Tuple[float, float, float, float]]) -> Optional[float]:
    if box_a is None or box_b is None:
        return None
    ax1, ay1, ax2, ay2 = box_a
    bx1, by1, bx2, by2 = box_b
    dx = max(0.0, ax1 - bx2, bx1 - ax2)
    dy = max(0.0, ay1 - by2, by1 - ay2)
    return math.hypot(dx, dy)


def _safe_norm(point_a: Sequence[float], point_b: Sequence[float]) -> float:
    return float(np.linalg.norm(np.asarray(point_a, dtype=np.float32) - np.asarray(point_b, dtype=np.float32)))


@dataclass
class EvidenceRecord:
    evidence_id: str
    evidence_type: str
    score: float
    step_start: int
    step_end: int
    source_ref: str
    notes: str = ""
    metadata: Dict[str, Any] = field(default_factory=dict)

    def to_dict(self) -> Dict[str, Any]:
        return {
            "evidence_id": self.evidence_id,
            "evidence_type": self.evidence_type,
            "score": _round_float(self.score),
            "step_start": int(self.step_start),
            "step_end": int(self.step_end),
            "source_ref": self.source_ref,
            "notes": self.notes,
            "metadata": dict(self.metadata),
        }


class RoomTopology:
    def __init__(
        self,
        sequence_id: Optional[str] = None,
        metadata: Optional[Dict[str, Any]] = None,
        evidence_weights: Optional[Dict[str, float]] = None,
        status_thresholds: Optional[Dict[str, float]] = None,
        route_relation_costs: Optional[Dict[str, float]] = None,
    ) -> None:
        self.version = TOPOLOGY_VERSION
        self.sequence_id = sequence_id
        self.graph = nx.MultiDiGraph()
        self.metadata = dict(metadata or {})
        self.evidence_weights = dict(DEFAULT_EVIDENCE_WEIGHTS)
        if evidence_weights:
            self.evidence_weights.update(evidence_weights)
        self.status_thresholds = dict(DEFAULT_STATUS_THRESHOLDS)
        if status_thresholds:
            self.status_thresholds.update(status_thresholds)
        self.route_relation_costs = dict(DEFAULT_ROUTE_RELATION_COSTS)
        if route_relation_costs:
            self.route_relation_costs.update(route_relation_costs)
        self.evidences: Dict[str, Dict[str, Any]] = {}
        self.floor_records: Dict[str, Dict[str, Any]] = {}
        self.object_to_room: Dict[str, str] = {}
        self.anchor_to_room: Dict[str, str] = {}
        self.room_to_objects: Dict[str, List[str]] = {}
        self.room_to_anchors: Dict[str, List[str]] = {}
        self.object_records: Dict[str, Dict[str, Any]] = {}
        self.anchor_records: Dict[str, Dict[str, Any]] = {}

    @classmethod
    def from_dict(cls, payload: Optional[Dict[str, Any]]) -> "RoomTopology":
        payload = dict(payload or {})
        topology = cls(
            sequence_id=payload.get("sequence_id"),
            metadata=dict(payload.get("metadata") or {}),
        )
        topology.version = str(payload.get("version", topology.version))
        topology.evidences = {
            str(item["evidence_id"]): dict(item)
            for item in payload.get("evidences", [])
            if item.get("evidence_id")
        }

        topology.floor_records = {
            str(item.get("floor_id")): dict(item)
            for item in payload.get("floors", [])
            if item.get("floor_id")
        }

        for room in payload.get("rooms", []):
            room_id = _canonical_room_id(room.get("id"))
            if room_id is None:
                continue
            polygon = [tuple(map(float, pt)) for pt in room.get("polygon", [])]
            center = room.get("center")
            if center is None:
                center = _polygon_centroid(polygon) if polygon else (0.0, 0.0)
            attrs = {
                "id": room_id,
                "node_type": "room",
                "room_uuid": room.get("room_uuid", _room_uuid(room_id)),
                "room_type": room.get("room_type", "unknown"),
                "floor_id": _clean_optional_text(room.get("floor_id")),
                "floor_index": room.get("floor_index"),
                "display_floor_id": _clean_optional_text(room.get("display_floor_id")) or _clean_optional_text(room.get("floor_id")),
                "display_order": room.get("display_order"),
                "floor_assignment_confidence": _round_float(room.get("floor_assignment_confidence")),
                "status": room.get("status", "confirmed"),
                "polygon": polygon,
                "center": [float(center[0]), float(center[1])],
                "area_m2": _round_float(room.get("area_m2", _polygon_area(polygon))),
            }
            topology.graph.add_node(room_id, **attrs)

        for edge in payload.get("edges", []):
            source = _canonical_room_id(edge.get("source"))
            target = _canonical_room_id(edge.get("target"))
            if source is None or target is None or source == target:
                continue
            if source not in topology.graph.nodes or target not in topology.graph.nodes:
                continue
            edge_attrs = {
                "relation_type": str(edge.get("relation_type")),
                "confidence": _round_float(edge.get("confidence", 0.0)),
                "status": edge.get("status"),
                "support_count": int(edge.get("support_count", 0)),
                "first_seen_step": edge.get("first_seen_step"),
                "last_seen_step": edge.get("last_seen_step"),
                "evidence_ids": list(edge.get("evidence_ids", [])),
                "metadata": dict(edge.get("metadata", {})),
                "source_room_id": source,
                "target_room_id": target,
            }
            topology.graph.add_edge(source, target, **edge_attrs)
            topology.graph.add_edge(target, source, **dict(edge_attrs, source_room_id=target, target_room_id=source))

        object_to_room = {}
        for object_id, room_id in dict(payload.get("indices", {}).get("object_to_room", {})).items():
            canonical_object_id = _canonical_object_id(object_id)
            canonical_room_id = _canonical_room_id(room_id)
            if canonical_object_id is None or canonical_room_id is None:
                continue
            object_to_room[canonical_object_id] = canonical_room_id
        topology.object_to_room = object_to_room

        anchor_to_room = {}
        for anchor_id, room_id in dict(payload.get("indices", {}).get("anchor_to_room", {})).items():
            canonical_anchor_id = _canonical_anchor_id(anchor_id)
            canonical_room_id = _canonical_room_id(room_id)
            if canonical_anchor_id is None or canonical_room_id is None:
                continue
            anchor_to_room[canonical_anchor_id] = canonical_room_id
        topology.anchor_to_room = anchor_to_room

        topology.room_to_objects = {
            room_id: sorted({
                canonical_object_id
                for object_id in object_ids
                for canonical_object_id in [_canonical_object_id(object_id)]
                if canonical_object_id is not None
            })
            for room_id, object_ids in {
                _canonical_room_id(key): value
                for key, value in dict(payload.get("indices", {}).get("room_to_objects", {})).items()
            }.items()
            if room_id is not None
        }
        topology.room_to_anchors = {
            room_id: sorted({
                canonical_anchor_id
                for anchor_id in anchor_ids
                for canonical_anchor_id in [_canonical_anchor_id(anchor_id)]
                if canonical_anchor_id is not None
            })
            for room_id, anchor_ids in {
                _canonical_room_id(key): value
                for key, value in dict(payload.get("indices", {}).get("room_to_anchors", {})).items()
            }.items()
            if room_id is not None
        }
        for room_id in topology.graph.nodes:
            topology.room_to_objects.setdefault(room_id, [])
            topology.room_to_anchors.setdefault(room_id, [])

        entities = dict(payload.get("entities") or {})
        for obj in entities.get("objects", []):
            object_id = _canonical_object_id(obj.get("id"))
            if object_id is None:
                continue
            label = _clean_optional_text(obj.get("label")) or _clean_optional_text(obj.get("category"))
            topology.object_records[object_id] = {
                "id": object_id,
                "label": label,
                "normalized_label": obj.get("normalized_label") or normalize_open_vocab_label(label),
                "category": obj.get("category"),
                "room_id": _canonical_room_id(obj.get("room_id")),
                "score": _round_float(obj.get("score")),
                "detection_confidence": _round_float(obj.get("detection_confidence")),
                "semantic_confidence": _round_float(obj.get("semantic_confidence")),
                "floor_id": _clean_optional_text(obj.get("floor_id")),
                "display_floor_id": _clean_optional_text(obj.get("display_floor_id")) or _clean_optional_text(obj.get("floor_id")),
                "display_order": obj.get("display_order"),
            }
        for object_id, room_id in topology.object_to_room.items():
            record = topology.object_records.setdefault(
                object_id,
                {
                    "id": object_id,
                    "label": None,
                    "normalized_label": None,
                    "category": None,
                    "room_id": room_id,
                    "score": None,
                    "detection_confidence": None,
                    "semantic_confidence": None,
                    "floor_id": None,
                    "display_floor_id": None,
                    "display_order": None,
                },
            )
            record["room_id"] = room_id

        for anchor in entities.get("anchors", []):
            anchor_id = _canonical_anchor_id(anchor.get("id"))
            if anchor_id is None:
                continue
            topology.anchor_records[anchor_id] = {
                "id": anchor_id,
                "anchor_type": anchor.get("anchor_type"),
                "room_id": _canonical_room_id(anchor.get("room_id")),
                "target_id": anchor.get("target_id"),
                "valid": bool(anchor.get("valid", True)),
                "score": _round_float(anchor.get("score")),
                "floor_id": _clean_optional_text(anchor.get("floor_id")),
                "display_floor_id": _clean_optional_text(anchor.get("display_floor_id")) or _clean_optional_text(anchor.get("floor_id")),
                "display_order": anchor.get("display_order"),
            }
        for anchor_id, room_id in topology.anchor_to_room.items():
            record = topology.anchor_records.setdefault(
                anchor_id,
                {
                    "id": anchor_id,
                    "anchor_type": None,
                    "room_id": room_id,
                    "target_id": None,
                    "valid": True,
                    "score": None,
                    "floor_id": None,
                    "display_floor_id": None,
                    "display_order": None,
                },
            )
            record["room_id"] = room_id
        return topology

    @classmethod
    def from_json(cls, path: Path) -> "RoomTopology":
        with open(path, "r", encoding="utf-8") as f:
            payload = json.load(f)
        return cls.from_dict(payload)

    def get_room(self, room_id: Any) -> Optional[Dict[str, Any]]:
        canonical = _canonical_room_id(room_id)
        if canonical is None or canonical not in self.graph.nodes:
            return None
        return dict(self.graph.nodes[canonical])

    def get_room_neighbors(
        self,
        room_id: Any,
        relation_types: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
    ) -> List[Dict[str, Any]]:
        canonical = _canonical_room_id(room_id)
        if canonical is None or canonical not in self.graph:
            return []
        relation_filter = None if relation_types is None else {str(item) for item in relation_types}
        neighbors: Dict[Tuple[str, str], Dict[str, Any]] = {}
        for _, target, data in self.graph.out_edges(canonical, data=True):
            relation_type = str(data.get("relation_type"))
            confidence = float(data.get("confidence", 0.0))
            if relation_filter is not None and relation_type not in relation_filter:
                continue
            if confidence < float(min_conf):
                continue
            key = (target, relation_type)
            payload = dict(data)
            payload["room_id"] = target
            neighbors[key] = payload
        return sorted(
            neighbors.values(),
            key=lambda item: (-float(item.get("confidence", 0.0)), str(item.get("room_id")), str(item.get("relation_type"))),
        )

    def get_room_of_object(self, object_id: Any) -> Optional[str]:
        return self.object_to_room.get(_canonical_object_id(object_id) or "")

    def get_room_of_anchor(self, anchor_id: Any) -> Optional[str]:
        return self.anchor_to_room.get(_canonical_anchor_id(anchor_id) or "")

    def get_object(self, object_id: Any) -> Optional[Dict[str, Any]]:
        canonical = _canonical_object_id(object_id)
        if canonical is None:
            return None
        record = self.object_records.get(canonical)
        return None if record is None else dict(record)

    def get_anchor(self, anchor_id: Any) -> Optional[Dict[str, Any]]:
        canonical = _canonical_anchor_id(anchor_id)
        if canonical is None:
            return None
        record = self.anchor_records.get(canonical)
        return None if record is None else dict(record)

    def get_room_contents(self, room_id: Any) -> Dict[str, Any]:
        canonical = _canonical_room_id(room_id)
        objects = list(self.room_to_objects.get(canonical or "", []))
        anchors = list(self.room_to_anchors.get(canonical or "", []))
        return {
            "room_id": canonical,
            "objects": objects,
            "anchors": anchors,
            "object_count": len(objects),
            "anchor_count": len(anchors),
        }

    def list_room_ids(self) -> List[str]:
        return sorted(
            [
                room_id
                for room_id, attrs in self.graph.nodes(data=True)
                if attrs.get("node_type") == "room"
            ],
            key=str,
        )

    def list_object_ids(self) -> List[str]:
        return sorted(set(self.object_records) | set(self.object_to_room), key=str)

    def list_anchor_ids(self, valid_only: bool = False) -> List[str]:
        anchor_ids = set(self.anchor_records) | set(self.anchor_to_room)
        if not valid_only:
            return sorted(anchor_ids, key=str)
        return sorted(
            [
                anchor_id
                for anchor_id in anchor_ids
                if bool(self.anchor_records.get(anchor_id, {}).get("valid", True))
            ],
            key=str,
        )

    def list_object_labels(self) -> List[str]:
        labels = {
            label
            for label in (
                _clean_optional_text(record.get("label")) for record in self.object_records.values()
            )
            if label is not None
        }
        return sorted(labels, key=str.lower)

    def inspect_export(self, sample_limit: int = 5) -> Dict[str, Any]:
        room_ids = self.list_room_ids()
        anchor_ids = self.list_anchor_ids()
        object_ids = self.list_object_ids()
        object_labels = self.list_object_labels()
        sample_limit = max(0, int(sample_limit))
        anchor_metadata_present = any(
            record.get("anchor_type") or record.get("target_id") or record.get("score") is not None
            for record in self.anchor_records.values()
        )
        object_metadata_present = any(
            record.get("label")
            or record.get("normalized_label")
            or record.get("category")
            or record.get("score") is not None
            or record.get("detection_confidence") is not None
            or record.get("semantic_confidence") is not None
            for record in self.object_records.values()
        )
        return {
            "floor_count": len(self.floor_records),
            "room_count": len(room_ids),
            "anchor_count": len(anchor_ids),
            "object_count": len(object_ids),
            "object_label_count": len(object_labels),
            "room_ids": room_ids,
            "anchor_ids": anchor_ids,
            "object_ids": object_ids,
            "object_labels": object_labels,
            "sample_room_ids": room_ids[:sample_limit],
            "sample_anchor_ids": anchor_ids[:sample_limit],
            "sample_object_ids": object_ids[:sample_limit],
            "sample_object_labels": object_labels[:sample_limit],
            "vertical_transition_edge_count": int(sum(1 for _, _, data in self.graph.edges(data=True) if data.get("relation_type") == "vertical_transition") // 2),
            "capabilities": {
                "anchor_lookup_available": bool(anchor_ids),
                "object_id_lookup_available": bool(object_ids),
                "object_label_lookup_available": bool(object_labels),
                "anchor_metadata_present": bool(anchor_metadata_present),
                "object_metadata_present": bool(object_metadata_present),
            },
        }

    def explain_connection(self, room_a: Any, room_b: Any) -> Dict[str, Any]:
        src = _canonical_room_id(room_a)
        dst = _canonical_room_id(room_b)
        explanation = {
            "room_a": src,
            "room_b": dst,
            "exists": False,
            "relations": [],
        }
        if src is None or dst is None:
            return explanation
        seen_relations = set()
        for direction_src, direction_dst in ((src, dst), (dst, src)):
            edge_data = self.graph.get_edge_data(direction_src, direction_dst, default={})
            for data in edge_data.values():
                relation_type = str(data.get("relation_type"))
                if relation_type in seen_relations:
                    continue
                seen_relations.add(relation_type)
                evidence_records = [
                    self.evidences[evidence_id]
                    for evidence_id in data.get("evidence_ids", [])
                    if evidence_id in self.evidences
                ]
                explanation["relations"].append(
                    {
                        "relation_type": relation_type,
                        "confidence": _round_float(data.get("confidence", 0.0)),
                        "status": data.get("status"),
                        "support_count": int(data.get("support_count", 0)),
                        "first_seen_step": data.get("first_seen_step"),
                        "last_seen_step": data.get("last_seen_step"),
                        "evidence_ids": list(data.get("evidence_ids", [])),
                        "evidences": evidence_records,
                        "metadata": dict(data.get("metadata", {})),
                    }
                )
        explanation["relations"] = sorted(
            explanation["relations"],
            key=lambda item: (-float(item.get("confidence", 0.0)), str(item.get("relation_type"))),
        )
        explanation["exists"] = bool(explanation["relations"])
        return explanation

    def _build_route_graph(
        self,
        allowed_relations: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
    ) -> Tuple[nx.DiGraph, Dict[str, Any]]:
        relation_filter = None if allowed_relations is None else {str(item) for item in allowed_relations}
        route_graph = nx.DiGraph()
        room_ids = sorted(
            [room_id for room_id, attrs in self.graph.nodes(data=True) if attrs.get("node_type") == "room"],
            key=str,
        )
        route_graph.add_nodes_from(room_ids)
        penalty_scale = float(
            self.metadata.get("max_route_confidence_penalty", DEFAULT_TOPOLOGY_CONFIG["max_route_confidence_penalty"])
        )
        retained_edge_count = 0
        for source, target, data in self.graph.edges(data=True):
            relation_type = str(data.get("relation_type"))
            confidence = float(data.get("confidence", 0.0))
            if relation_filter is not None and relation_type not in relation_filter:
                continue
            if confidence < float(min_conf):
                continue
            base_cost = float(self.route_relation_costs.get(relation_type, 2.0))
            candidate_cost = base_cost + penalty_scale * (1.0 - confidence)
            existing = route_graph.get_edge_data(source, target, default=None)
            if existing is not None and float(existing.get("weight", float("inf"))) <= candidate_cost:
                continue
            route_graph.add_edge(
                source,
                target,
                weight=candidate_cost,
                relation_type=relation_type,
                confidence=confidence,
                status=data.get("status"),
                support_count=int(data.get("support_count", 0)),
                evidence_ids=list(data.get("evidence_ids", [])),
                metadata=dict(data.get("metadata", {})),
            )
        retained_edge_count = int(route_graph.number_of_edges())
        return route_graph, {
            "allowed_relations": None if relation_filter is None else sorted(relation_filter),
            "min_conf": _round_float(min_conf),
            "node_count": int(route_graph.number_of_nodes()),
            "edge_count": retained_edge_count,
        }

    def _make_failed_path_result(
        self,
        src: Optional[str],
        dst: Optional[str],
        method: str,
        failure_reason: str,
        route_graph_stats: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        return {
            "found": False,
            "method": str(method),
            "start_room_id": src,
            "goal_room_id": dst,
            "failure_reason": str(failure_reason),
            "room_sequence": [],
            "edges": [],
            "used_relation_types": [],
            "edge_confidences": [],
            "hop_count": 0,
            "total_cost": None,
            "route_confidence": None,
            "score_summary": {
                "hop_count": 0,
                "total_cost": None,
                "route_confidence": None,
            },
            "search_space": dict(route_graph_stats or {}),
        }

    def _make_path_result(
        self,
        room_sequence: Sequence[str],
        route_graph: nx.DiGraph,
        method: str,
        route_graph_stats: Optional[Dict[str, Any]] = None,
    ) -> Dict[str, Any]:
        edges: List[Dict[str, Any]] = []
        total_cost = 0.0
        edge_confidences: List[float] = []
        used_relation_types: List[str] = []
        for idx in range(len(room_sequence) - 1):
            source = room_sequence[idx]
            target = room_sequence[idx + 1]
            data = route_graph[source][target]
            confidence = float(data.get("confidence", 0.0))
            edge_cost = float(data.get("weight", 0.0))
            relation_type = str(data.get("relation_type"))
            edges.append(
                {
                    "source_room_id": source,
                    "target_room_id": target,
                    "relation_type": relation_type,
                    "confidence": _round_float(confidence),
                    "status": data.get("status"),
                    "support_count": int(data.get("support_count", 0)),
                    "edge_cost": _round_float(edge_cost),
                    "evidence_ids": list(data.get("evidence_ids", [])),
                    "metadata": dict(data.get("metadata", {})),
                }
            )
            total_cost += edge_cost
            edge_confidences.append(confidence)
            used_relation_types.append(relation_type)
        route_confidence = min(edge_confidences) if edge_confidences else 1.0
        return {
            "found": True,
            "method": str(method),
            "start_room_id": room_sequence[0] if room_sequence else None,
            "goal_room_id": room_sequence[-1] if room_sequence else None,
            "failure_reason": None,
            "room_sequence": list(room_sequence),
            "edges": edges,
            "used_relation_types": used_relation_types,
            "edge_confidences": [_round_float(value) for value in edge_confidences],
            "hop_count": max(0, len(room_sequence) - 1),
            "total_cost": _round_float(total_cost),
            "route_confidence": _round_float(route_confidence),
            "score_summary": {
                "hop_count": max(0, len(room_sequence) - 1),
                "total_cost": _round_float(total_cost),
                "route_confidence": _round_float(route_confidence),
            },
            "search_space": dict(route_graph_stats or {}),
        }

    def find_room_path(
        self,
        start_room_id: Any,
        goal_room_id: Any,
        allowed_relations: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
        method: str = "shortest",
    ) -> Dict[str, Any]:
        src = _canonical_room_id(start_room_id)
        dst = _canonical_room_id(goal_room_id)
        if method != "shortest":
            return self._make_failed_path_result(src, dst, method, f"unsupported_method:{method}")
        if src is None:
            return self._make_failed_path_result(src, dst, method, "invalid_start_room_id")
        if dst is None:
            return self._make_failed_path_result(src, dst, method, "invalid_goal_room_id")
        if src not in self.graph.nodes:
            return self._make_failed_path_result(src, dst, method, "start_room_not_in_topology")
        if dst not in self.graph.nodes:
            return self._make_failed_path_result(src, dst, method, "goal_room_not_in_topology")

        route_graph, route_graph_stats = self._build_route_graph(
            allowed_relations=allowed_relations,
            min_conf=min_conf,
        )
        if src == dst:
            return self._make_path_result([src], route_graph, method, route_graph_stats=route_graph_stats)
        if int(route_graph_stats.get("edge_count", 0)) == 0:
            return self._make_failed_path_result(
                src,
                dst,
                method,
                "no_edges_available_under_filters",
                route_graph_stats=route_graph_stats,
            )
        try:
            room_sequence = nx.shortest_path(route_graph, src, dst, weight="weight")
        except (nx.NetworkXNoPath, nx.NodeNotFound):
            return self._make_failed_path_result(
                src,
                dst,
                method,
                "no_path_found",
                route_graph_stats=route_graph_stats,
            )
        return self._make_path_result(room_sequence, route_graph, method, route_graph_stats=route_graph_stats)

    def find_candidate_room_paths(
        self,
        start_room_id: Any,
        goal_room_id: Any,
        allowed_relations: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
        method: str = "shortest",
        max_paths: int = 3,
    ) -> Dict[str, Any]:
        src = _canonical_room_id(start_room_id)
        dst = _canonical_room_id(goal_room_id)
        if int(max_paths) <= 0:
            return {
                "found": False,
                "failure_reason": "max_paths_must_be_positive",
                "paths": [],
                "method": str(method),
                "start_room_id": src,
                "goal_room_id": dst,
            }
        best_path = self.find_room_path(
            src,
            dst,
            allowed_relations=allowed_relations,
            min_conf=min_conf,
            method=method,
        )
        if not best_path.get("found"):
            return {
                "found": False,
                "failure_reason": best_path.get("failure_reason"),
                "paths": [],
                "method": str(method),
                "start_room_id": src,
                "goal_room_id": dst,
                "search_space": dict(best_path.get("search_space", {})),
            }
        if int(max_paths) == 1 or best_path.get("hop_count", 0) == 0:
            return {
                "found": True,
                "failure_reason": None,
                "paths": [dict(best_path, candidate_rank=1)],
                "method": str(method),
                "start_room_id": src,
                "goal_room_id": dst,
                "search_space": dict(best_path.get("search_space", {})),
            }

        route_graph, route_graph_stats = self._build_route_graph(
            allowed_relations=allowed_relations,
            min_conf=min_conf,
        )
        try:
            path_iter = nx.shortest_simple_paths(route_graph, src, dst, weight="weight")
            paths = [
                dict(
                    self._make_path_result(room_sequence, route_graph, method, route_graph_stats=route_graph_stats),
                    candidate_rank=idx + 1,
                )
                for idx, room_sequence in enumerate(islice(path_iter, int(max_paths)))
            ]
        except (nx.NetworkXNoPath, nx.NodeNotFound):
            paths = []
        return {
            "found": bool(paths),
            "failure_reason": None if paths else "no_path_found",
            "paths": paths,
            "method": str(method),
            "start_room_id": src,
            "goal_room_id": dst,
            "search_space": route_graph_stats,
        }

    def explain_room_path(
        self,
        start_room_id: Any,
        goal_room_id: Any,
        allowed_relations: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
        method: str = "shortest",
    ) -> Dict[str, Any]:
        route = self.find_room_path(
            start_room_id,
            goal_room_id,
            allowed_relations=allowed_relations,
            min_conf=min_conf,
            method=method,
        )
        if not route.get("found"):
            return route
        hop_explanations = []
        for edge in route.get("edges", []):
            connection = self.explain_connection(edge["source_room_id"], edge["target_room_id"])
            relation_explanation = next(
                (
                    item
                    for item in connection.get("relations", [])
                    if item.get("relation_type") == edge["relation_type"]
                ),
                None,
            )
            hop_explanations.append(
                {
                    "source_room_id": edge["source_room_id"],
                    "target_room_id": edge["target_room_id"],
                    "relation_type": edge["relation_type"],
                    "edge_cost": edge["edge_cost"],
                    "confidence": edge["confidence"],
                    "relation_explanation": relation_explanation,
                }
            )
        return dict(route, hop_explanations=hop_explanations)

    def find_room_route(
        self,
        src_room: Any,
        dst_room: Any,
        allowed_relations: Optional[Iterable[str]] = None,
        min_conf: float = 0.0,
    ) -> Optional[Dict[str, Any]]:
        path = self.find_room_path(
            src_room,
            dst_room,
            allowed_relations=allowed_relations,
            min_conf=min_conf,
            method="shortest",
        )
        if not path.get("found"):
            return None
        return {
            "room_sequence": list(path.get("room_sequence", [])),
            "used_relation_types": list(path.get("used_relation_types", [])),
            "edge_confidences": list(path.get("edge_confidences", [])),
            "total_cost": path.get("total_cost"),
            "route_confidence": path.get("route_confidence"),
        }

    def summarize_room(self, room_id: Any) -> Dict[str, Any]:
        room = self.get_room(room_id)
        if room is None:
            return {"room_id": _canonical_room_id(room_id), "exists": False}
        neighbors = self.get_room_neighbors(room_id)
        contents = self.get_room_contents(room_id)
        return {
            "room_id": room["id"],
            "exists": True,
            "room_type": room.get("room_type", "unknown"),
            "room_uuid": room.get("room_uuid"),
            "floor_id": room.get("floor_id"),
            "floor_index": room.get("floor_index"),
            "display_floor_id": room.get("display_floor_id"),
            "display_order": room.get("display_order"),
            "area_m2": room.get("area_m2"),
            "center": room.get("center"),
            "object_count": contents["object_count"],
            "anchor_count": contents["anchor_count"],
            "neighbors": neighbors,
        }

    def validate(self) -> List[str]:
        errors: List[str] = []
        for room_id, attrs in self.graph.nodes(data=True):
            if attrs.get("node_type") != "room":
                continue
            floor_id = attrs.get("floor_id")
            if floor_id is not None and self.floor_records and floor_id not in self.floor_records:
                errors.append(f"room references missing floor: {room_id} -> {floor_id}")
        for room_id, object_ids in self.room_to_objects.items():
            if room_id not in self.graph.nodes:
                errors.append(f"room_to_objects references missing room: {room_id}")
            for object_id in object_ids:
                if self.object_to_room.get(object_id) != room_id:
                    errors.append(f"object_to_room mismatch for {object_id}: expected {room_id}")
        for object_id, record in self.object_records.items():
            room_id = record.get("room_id")
            floor_id = record.get("floor_id")
            if room_id is not None and room_id not in self.graph.nodes:
                errors.append(f"object references missing room: {object_id} -> {room_id}")
                continue
            if room_id is not None and floor_id is not None:
                room_floor_id = self.graph.nodes[room_id].get("floor_id")
                if room_floor_id is not None and room_floor_id != floor_id:
                    errors.append(f"object floor mismatch for {object_id}: room={room_floor_id}, object={floor_id}")
        for room_id, anchor_ids in self.room_to_anchors.items():
            if room_id not in self.graph.nodes:
                errors.append(f"room_to_anchors references missing room: {room_id}")
            for anchor_id in anchor_ids:
                if self.anchor_to_room.get(anchor_id) != room_id:
                    errors.append(f"anchor_to_room mismatch for {anchor_id}: expected {room_id}")
        for anchor_id, record in self.anchor_records.items():
            room_id = record.get("room_id")
            floor_id = record.get("floor_id")
            if room_id is not None and room_id not in self.graph.nodes:
                errors.append(f"anchor references missing room: {anchor_id} -> {room_id}")
                continue
            if room_id is not None and floor_id is not None:
                room_floor_id = self.graph.nodes[room_id].get("floor_id")
                if room_floor_id is not None and room_floor_id != floor_id:
                    errors.append(f"anchor floor mismatch for {anchor_id}: room={room_floor_id}, anchor={floor_id}")
        for source, target, data in self.graph.edges(data=True):
            if source not in self.graph.nodes:
                errors.append(f"edge source missing: {source}")
            if target not in self.graph.nodes:
                errors.append(f"edge target missing: {target}")
            relation_type = str(data.get("relation_type"))
            source_floor = self.graph.nodes.get(source, {}).get("floor_id")
            target_floor = self.graph.nodes.get(target, {}).get("floor_id")
            if relation_type in {"adjacent", "transition", "possible_connection"} and source_floor != target_floor:
                errors.append(f"same-floor relation crosses floors: {source} -[{relation_type}]-> {target}")
            if relation_type == "vertical_transition" and source_floor == target_floor:
                errors.append(f"vertical_transition must connect different floors: {source} -> {target}")
            for evidence_id in data.get("evidence_ids", []):
                if evidence_id not in self.evidences:
                    errors.append(f"missing evidence reference: {evidence_id}")
        return errors

    def to_dict(self, include_query_examples: bool = True) -> Dict[str, Any]:
        rooms = []
        floors = [dict(self.floor_records[floor_id]) for floor_id in sorted(self.floor_records)]
        for room_id, attrs in sorted(self.graph.nodes(data=True), key=lambda item: str(item[0])):
            if attrs.get("node_type") != "room":
                continue
            rooms.append(
                {
                    "id": room_id,
                    "room_uuid": attrs.get("room_uuid"),
                    "room_type": attrs.get("room_type", "unknown"),
                    "floor_id": attrs.get("floor_id"),
                    "floor_index": attrs.get("floor_index"),
                    "display_floor_id": attrs.get("display_floor_id"),
                    "display_order": attrs.get("display_order"),
                    "floor_assignment_confidence": _round_float(attrs.get("floor_assignment_confidence")),
                    "status": attrs.get("status", "confirmed"),
                    "center": list(attrs.get("center", [])),
                    "polygon": [list(map(float, pt)) for pt in attrs.get("polygon", [])],
                    "area_m2": _round_float(attrs.get("area_m2", 0.0)),
                }
            )
        edges: List[Dict[str, Any]] = []
        seen: Set[Tuple[str, str, str]] = set()
        for source, target, data in self.graph.edges(data=True):
            relation_type = str(data.get("relation_type"))
            key = tuple(sorted((source, target))) + (relation_type,)
            if key in seen:
                continue
            seen.add(key)
            edges.append(
                {
                    "source": source,
                    "target": target,
                    "relation_type": relation_type,
                    "confidence": _round_float(data.get("confidence", 0.0)),
                    "status": data.get("status"),
                    "support_count": int(data.get("support_count", 0)),
                    "first_seen_step": data.get("first_seen_step"),
                    "last_seen_step": data.get("last_seen_step"),
                    "evidence_ids": list(data.get("evidence_ids", [])),
                    "metadata": dict(data.get("metadata", {})),
                }
            )
        payload = {
            "version": self.version,
            "sequence_id": self.sequence_id,
            "floors": floors,
            "rooms": rooms,
            "edges": sorted(edges, key=lambda item: (item["source"], item["target"], item["relation_type"])),
            "indices": {
                "object_to_room": dict(self.object_to_room),
                "anchor_to_room": dict(self.anchor_to_room),
                "room_to_objects": {key: list(value) for key, value in sorted(self.room_to_objects.items())},
                "room_to_anchors": {key: list(value) for key, value in sorted(self.room_to_anchors.items())},
            },
            "entities": {
                "objects": [
                    dict(self.object_records[object_id])
                    for object_id in sorted(self.object_records)
                ],
                "anchors": [
                    dict(self.anchor_records[anchor_id])
                    for anchor_id in sorted(self.anchor_records)
                ],
            },
            "evidences": [self.evidences[evidence_id] for evidence_id in sorted(self.evidences)],
            "metadata": dict(self.metadata),
        }
        if include_query_examples:
            payload["query_examples"] = self.build_query_examples()
        return payload

    def build_query_examples(self) -> Dict[str, Any]:
        room_ids = sorted(
            [room_id for room_id, attrs in self.graph.nodes(data=True) if attrs.get("node_type") == "room"],
            key=str,
        )
        inspection = self.inspect_export(sample_limit=5)
        examples: Dict[str, Any] = {
            "floor_count": len(self.floor_records),
            "room_count": len(room_ids),
            "edge_count": int(sum(1 for _ in self.graph.edges()) // 2),
            "anchor_count": int(inspection["anchor_count"]),
            "object_count": int(inspection["object_count"]),
            "object_label_count": int(inspection["object_label_count"]),
            "sample_room_ids": list(inspection["sample_room_ids"]),
            "sample_anchor_ids": list(inspection["sample_anchor_ids"]),
            "sample_object_ids": list(inspection["sample_object_ids"]),
            "sample_object_labels": list(inspection["sample_object_labels"]),
            "capabilities": dict(inspection["capabilities"]),
        }
        if not room_ids:
            return examples
        examples["first_room_summary"] = self.summarize_room(room_ids[0])
        if self.anchor_to_room:
            first_anchor_id = sorted(self.anchor_to_room)[0]
            examples["first_anchor_lookup"] = {
                "anchor_id": first_anchor_id,
                "room_id": self.get_room_of_anchor(first_anchor_id),
            }
        if len(room_ids) >= 2:
            examples["first_connection_explanation"] = self.explain_connection(room_ids[0], room_ids[1])
            route = self.find_room_route(room_ids[0], room_ids[-1], min_conf=0.0)
            examples["first_route"] = route
        return examples

    def export_json(self, path: Path, include_query_examples: bool = True) -> Path:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(self.to_dict(include_query_examples=include_query_examples), f, indent=2)
        return path

    def export_query_report(self, path: Path) -> Path:
        path.parent.mkdir(parents=True, exist_ok=True)
        with open(path, "w", encoding="utf-8") as f:
            json.dump(self.build_query_examples(), f, indent=2)
        return path

    def export_graphml(self, path: Path) -> Path:
        path.parent.mkdir(parents=True, exist_ok=True)
        graph = nx.MultiDiGraph()
        for node_id, attrs in self.graph.nodes(data=True):
            if attrs.get("node_type") != "room":
                continue
            graph.add_node(
                node_id,
                room_uuid=str(attrs.get("room_uuid", "")),
                room_type=str(attrs.get("room_type", "unknown")),
                floor_id=str(attrs.get("floor_id", "")),
                area_m2=str(_round_float(attrs.get("area_m2", 0.0)) or 0.0),
            )
        seen: Set[Tuple[str, str, str]] = set()
        for source, target, data in self.graph.edges(data=True):
            relation_type = str(data.get("relation_type"))
            key = tuple(sorted((source, target))) + (relation_type,)
            if key in seen:
                continue
            seen.add(key)
            if source not in graph.nodes or target not in graph.nodes:
                continue
            graph.add_edge(
                source,
                target,
                relation_type=relation_type,
                confidence=str(_round_float(data.get("confidence", 0.0)) or 0.0),
                status=str(data.get("status", "weak")),
                support_count=str(int(data.get("support_count", 0))),
            )
        nx.write_graphml(graph, path)
        return path


class RoomTopologyBuilder:
    def __init__(
        self,
        config: Optional[Dict[str, Any]] = None,
        evidence_weights: Optional[Dict[str, float]] = None,
        status_thresholds: Optional[Dict[str, float]] = None,
        route_relation_costs: Optional[Dict[str, float]] = None,
    ) -> None:
        self.config = dict(DEFAULT_TOPOLOGY_CONFIG)
        if config:
            self.config.update(config)
        self.evidence_weights = dict(DEFAULT_EVIDENCE_WEIGHTS)
        if evidence_weights:
            self.evidence_weights.update(evidence_weights)
        self.status_thresholds = dict(DEFAULT_STATUS_THRESHOLDS)
        if status_thresholds:
            self.status_thresholds.update(status_thresholds)
        self.route_relation_costs = dict(DEFAULT_ROUTE_RELATION_COSTS)
        if route_relation_costs:
            self.route_relation_costs.update(route_relation_costs)
        self._evidence_counter = 1

    def build(
        self,
        vector_map: Optional[Dict[str, Any]],
        sequence_id: Optional[str] = None,
        transition_history: Optional[Sequence[Dict[str, Any]]] = None,
        metadata: Optional[Dict[str, Any]] = None,
    ) -> RoomTopology:
        topology = RoomTopology(
            sequence_id=sequence_id,
            metadata=dict(metadata or {}),
            evidence_weights=self.evidence_weights,
            status_thresholds=self.status_thresholds,
            route_relation_costs=self.route_relation_costs,
        )
        topology.metadata.setdefault("builder_version", TOPOLOGY_VERSION)
        topology.metadata.setdefault("max_route_confidence_penalty", self.config["max_route_confidence_penalty"])
        world = dict(vector_map or {})
        room_lookup = self._sync_rooms(topology, world)
        self._sync_containment_indices(topology, world, room_lookup)
        edge_support = self._collect_edge_support(world, transition_history or [], room_lookup)
        self._materialize_edges(topology, edge_support)
        return topology

    def build_from_stage_a_sequence_dir(
        self,
        sequence_dir: Path,
        sequence_id: Optional[str] = None,
    ) -> RoomTopology:
        sequence_dir = Path(sequence_dir)
        log_dir = sequence_dir / "logs"
        summary_path = log_dir / "summary.json"
        timeline_path = log_dir / "timeline.json"
        summary: Dict[str, Any] = {}
        if summary_path.exists():
            with open(summary_path, "r", encoding="utf-8") as f:
                summary = json.load(f)
        if not timeline_path.exists():
            raise FileNotFoundError(f"Missing timeline export: {timeline_path}")
        with open(timeline_path, "r", encoding="utf-8") as f:
            timeline_rows = json.load(f)
        transition_history = []
        final_vector_map = None
        vector_map_cache: Dict[str, Dict[str, Any]] = {}
        for row in timeline_rows:
            vector_map_path = row.get("vector_map_path")
            if not vector_map_path:
                continue
            vector_map_file = Path(vector_map_path)
            if not vector_map_file.exists():
                continue
            cache_key = str(vector_map_file)
            if cache_key not in vector_map_cache:
                with open(vector_map_file, "r", encoding="utf-8") as f:
                    vector_map_cache[cache_key] = json.load(f)
            vector_map = vector_map_cache[cache_key]
            final_vector_map = vector_map
            transition_history.append(
                {
                    "frame_idx": int(row.get("frame_idx", 0)),
                    "timestamp": float(row.get("timestamp", 0.0)),
                    "current_room_id": row.get("current_room_id"),
                }
            )
        if final_vector_map is None:
            raise FileNotFoundError(f"No vector_map exports referenced by {timeline_path}")
        metadata = {
            "sequence_dir": str(sequence_dir),
            "timeline_path": str(timeline_path),
            "summary_path": str(summary_path) if summary_path.exists() else None,
            "room_seg_interval": summary.get("presentation_parameters", {}).get("room_seg_interval"),
            "replay_mode": summary.get("replay_mode"),
        }
        return self.build(
            final_vector_map,
            sequence_id=sequence_id or summary.get("sequence_id") or sequence_dir.name,
            transition_history=transition_history,
            metadata=metadata,
        )

    def _sync_rooms(self, topology: RoomTopology, world: Dict[str, Any]) -> Dict[str, Dict[str, Any]]:
        room_lookup: Dict[str, Dict[str, Any]] = {}
        topology.floor_records = {
            str(item.get("floor_id")): dict(item)
            for item in world.get("floors", [])
            if item.get("floor_id")
        }
        for room in world.get("rooms", []):
            room_id = _canonical_room_id(room.get("id"))
            if room_id is None:
                continue
            polygon = [tuple(map(float, pt)) for pt in room.get("polygon", [])]
            center = _polygon_centroid(polygon) if polygon else (0.0, 0.0)
            attrs = {
                "id": room_id,
                "node_type": "room",
                "room_uuid": _room_uuid(room_id),
                "room_type": room.get("room_type", "unknown"),
                "floor_id": _clean_optional_text(room.get("floor_id")),
                "floor_index": room.get("floor_index"),
                "display_floor_id": _clean_optional_text(room.get("display_floor_id")) or _clean_optional_text(room.get("floor_id")),
                "display_order": room.get("display_order"),
                "floor_assignment_confidence": _round_float(room.get("floor_assignment_confidence")),
                "status": room.get("status", "confirmed"),
                "polygon": polygon,
                "center": [float(center[0]), float(center[1])],
                "area_m2": _round_float(_polygon_area(polygon)),
            }
            topology.graph.add_node(room_id, **attrs)
            room_lookup[room_id] = attrs
        return room_lookup

    def _sync_containment_indices(
        self,
        topology: RoomTopology,
        world: Dict[str, Any],
        room_lookup: Dict[str, Dict[str, Any]],
    ) -> None:
        topology.object_to_room = {}
        topology.anchor_to_room = {}
        topology.room_to_objects = {room_id: [] for room_id in room_lookup}
        topology.room_to_anchors = {room_id: [] for room_id in room_lookup}
        topology.object_records = {}
        topology.anchor_records = {}

        for obj in world.get("objects", []):
            object_id = _canonical_object_id(obj.get("id"))
            room_id = self._resolve_object_room_id(obj)
            if object_id is None:
                continue
            label = _clean_optional_text(obj.get("label")) or _clean_optional_text(obj.get("category"))
            topology.object_records[object_id] = {
                "id": object_id,
                "label": label,
                "normalized_label": normalize_open_vocab_label(label),
                "category": obj.get("category"),
                "room_id": room_id,
                "score": _round_float(obj.get("score")),
                "detection_confidence": _round_float(obj.get("detection_confidence")),
                "semantic_confidence": _round_float(obj.get("semantic_confidence")),
                "floor_id": _clean_optional_text(obj.get("floor_id")),
                "display_floor_id": _clean_optional_text(obj.get("display_floor_id")) or _clean_optional_text(obj.get("floor_id")),
                "display_order": obj.get("display_order"),
            }
            if room_id is None or room_id not in room_lookup:
                continue
            topology.object_to_room[object_id] = room_id
            topology.room_to_objects.setdefault(room_id, []).append(object_id)

        for anchor in world.get("anchors", []):
            anchor_id = _canonical_anchor_id(anchor.get("id"))
            if anchor_id is None:
                continue
            room_id = self._resolve_anchor_room_id(anchor, topology.object_to_room)
            topology.anchor_records[anchor_id] = {
                "id": anchor_id,
                "anchor_type": anchor.get("anchor_type"),
                "room_id": room_id,
                "target_id": anchor.get("target_id"),
                "valid": bool(anchor.get("valid", True)),
                "score": _round_float(anchor.get("score")),
                "floor_id": _clean_optional_text(anchor.get("floor_id")),
                "display_floor_id": _clean_optional_text(anchor.get("display_floor_id")) or _clean_optional_text(anchor.get("floor_id")),
                "display_order": anchor.get("display_order"),
            }
            if room_id is None or room_id not in room_lookup:
                continue
            topology.anchor_to_room[anchor_id] = room_id
            topology.room_to_anchors.setdefault(room_id, []).append(anchor_id)

        for room_id in list(topology.room_to_objects):
            topology.room_to_objects[room_id] = sorted(set(topology.room_to_objects[room_id]))
        for room_id in list(topology.room_to_anchors):
            topology.room_to_anchors[room_id] = sorted(set(topology.room_to_anchors[room_id]))

    def _resolve_object_room_id(self, obj: Dict[str, Any]) -> Optional[str]:
        for key in ("room_uuid", "room_id"):
            room_id = _canonical_room_id(obj.get(key))
            if room_id is not None:
                return room_id
        return None

    def _resolve_anchor_room_id(
        self,
        anchor: Dict[str, Any],
        object_to_room: Dict[str, str],
    ) -> Optional[str]:
        room_id = _canonical_room_id(anchor.get("room_id"))
        if room_id is not None:
            return room_id
        target_id = anchor.get("target_id")
        target_room_id = _canonical_room_id(target_id)
        if target_room_id is not None and str(target_room_id).startswith("room_"):
            return target_room_id
        target_object_id = _canonical_object_id(target_id)
        if target_object_id is not None:
            return object_to_room.get(target_object_id)
        return None

    def _collect_edge_support(
        self,
        world: Dict[str, Any],
        transition_history: Sequence[Dict[str, Any]],
        room_lookup: Dict[str, Dict[str, Any]],
    ) -> Dict[Tuple[str, str], Dict[str, Dict[str, Any]]]:
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]] = {}
        self._collect_adjacency_support(edge_support, world, room_lookup)
        self._collect_transition_support(edge_support, transition_history, room_lookup)
        self._collect_vertical_transition_support(edge_support, world, room_lookup)
        self._promote_possible_connections(edge_support)
        return edge_support

    def _collect_adjacency_support(
        self,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
        world: Dict[str, Any],
        room_lookup: Dict[str, Dict[str, Any]],
    ) -> None:
        gateway_pairs: Dict[Tuple[str, str], Dict[str, Any]] = {}
        for idx, gateway in enumerate(world.get("gateways", [])):
            connects = gateway.get("connects", [])
            if len(connects) != 2:
                continue
            room_a = _canonical_room_id(connects[0])
            room_b = _canonical_room_id(connects[1])
            if room_a is None or room_b is None or room_a == room_b:
                continue
            if room_a not in room_lookup or room_b not in room_lookup:
                continue
            if room_lookup[room_a].get("floor_id") != room_lookup[room_b].get("floor_id"):
                continue
            pair = tuple(sorted((room_a, room_b)))
            info = gateway_pairs.setdefault(
                pair,
                {
                    "gateway_count": 0,
                    "door_count": 0,
                    "open_passage_count": 0,
                    "positions": [],
                    "gateway_indices": [],
                },
            )
            info["gateway_count"] += 1
            info["gateway_indices"].append(int(idx))
            gate_type = str(gateway.get("type", "open_passage"))
            if gate_type == "door":
                info["door_count"] += 1
            else:
                info["open_passage_count"] += 1
            pos_world = gateway.get("pos_world", [])
            if len(pos_world) >= 2:
                info["positions"].append([float(pos_world[0]), float(pos_world[1])])

        for pair, info in gateway_pairs.items():
            boundary_score = min(1.0, float(info["gateway_count"]) / 2.0)
            boundary_evidence = self._make_evidence(
                "boundary_contact",
                score=boundary_score,
                step_start=0,
                step_end=0,
                source_ref=f"gateways:{','.join(str(v) for v in info['gateway_indices'])}",
                notes="gateway-linked room boundary contact",
                metadata={
                    "gateway_count": int(info["gateway_count"]),
                    "positions": list(info["positions"]),
                },
            )
            self._attach_evidence(edge_support, pair, "adjacent", boundary_evidence)

            if int(info["open_passage_count"]) > 0:
                shared_frontier = self._make_evidence(
                    "shared_frontier",
                    score=min(1.0, float(info["open_passage_count"]) / 2.0),
                    step_start=0,
                    step_end=0,
                    source_ref=f"gateways:{','.join(str(v) for v in info['gateway_indices'])}",
                    notes="open-passage gateway suggests shared frontier",
                    metadata={"open_passage_count": int(info["open_passage_count"])},
                )
                self._attach_evidence(edge_support, pair, "adjacent", shared_frontier)

            if int(info["door_count"]) > 0:
                door_evidence = self._make_evidence(
                    "door_detection",
                    score=min(1.0, float(info["door_count"])),
                    step_start=0,
                    step_end=0,
                    source_ref=f"gateways:{','.join(str(v) for v in info['gateway_indices'])}",
                    notes="door gateway detected between room polygons",
                    metadata={"door_count": int(info["door_count"])},
                )
                self._attach_evidence(edge_support, pair, "adjacent", door_evidence)

        room_ids = sorted(room_lookup)
        room_boxes = {room_id: _bbox(room_lookup[room_id].get("polygon", [])) for room_id in room_ids}
        room_centers = {room_id: room_lookup[room_id].get("center", [0.0, 0.0]) for room_id in room_ids}
        adjacency_distance = float(self.config["adjacency_distance_m"])
        possible_distance = float(self.config["possible_connection_distance_m"])
        for idx, room_a in enumerate(room_ids):
            for room_b in room_ids[idx + 1:]:
                if room_lookup[room_a].get("floor_id") != room_lookup[room_b].get("floor_id"):
                    continue
                pair = tuple(sorted((room_a, room_b)))
                gap = _bbox_gap(room_boxes[room_a], room_boxes[room_b])
                if gap is None:
                    continue
                center_distance = _safe_norm(room_centers[room_a], room_centers[room_b])
                if gap <= adjacency_distance:
                    score = _clamp01(1.0 - gap / max(adjacency_distance, 1e-6))
                    evidence = self._make_evidence(
                        "boundary_contact",
                        score=max(score, 0.25),
                        step_start=0,
                        step_end=0,
                        source_ref="polygon_proximity",
                        notes=f"room polygons are boundary-near (gap={gap:.3f}m)",
                        metadata={
                            "gap_m": _round_float(gap),
                            "center_distance_m": _round_float(center_distance),
                        },
                    )
                    self._attach_evidence(edge_support, pair, "adjacent", evidence)
                elif gap <= possible_distance:
                    score = _clamp01(1.0 - gap / max(possible_distance, 1e-6))
                    evidence = self._make_evidence(
                        "shared_frontier",
                        score=max(score, 0.1),
                        step_start=0,
                        step_end=0,
                        source_ref="polygon_proximity",
                        notes=f"room polygons are nearby but not in strong contact (gap={gap:.3f}m)",
                        metadata={
                            "gap_m": _round_float(gap),
                            "center_distance_m": _round_float(center_distance),
                        },
                    )
                    self._attach_evidence(edge_support, pair, "possible_connection", evidence)

    def _collect_transition_support(
        self,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
        transition_history: Sequence[Dict[str, Any]],
        room_lookup: Dict[str, Dict[str, Any]],
    ) -> None:
        segments = self._stable_room_segments(transition_history)
        pair_switches: Dict[Tuple[str, str], List[Tuple[Dict[str, Any], Dict[str, Any]]]] = {}
        for idx in range(len(segments) - 1):
            previous_seg = segments[idx]
            next_seg = segments[idx + 1]
            room_a = previous_seg["room_id"]
            room_b = next_seg["room_id"]
            if room_a is None or room_b is None or room_a == room_b:
                continue
            if int(previous_seg["obs_count"]) < int(self.config["room_switch_min_segment_len"]):
                continue
            if int(next_seg["obs_count"]) < int(self.config["room_switch_min_segment_len"]):
                continue
            if room_lookup.get(room_a, {}).get("floor_id") != room_lookup.get(room_b, {}).get("floor_id"):
                continue
            pair = tuple(sorted((room_a, room_b)))
            pair_switches.setdefault(pair, []).append((previous_seg, next_seg))
            evidence = self._make_evidence(
                "trajectory_transition",
                score=1.0,
                step_start=int(previous_seg["frame_end"]),
                step_end=int(next_seg["frame_start"]),
                source_ref=f"frames:{previous_seg['frame_end']}->{next_seg['frame_start']}",
                notes="stable room-to-room switch observed in trajectory history",
                metadata={
                    "from_room": room_a,
                    "to_room": room_b,
                    "from_obs_count": int(previous_seg["obs_count"]),
                    "to_obs_count": int(next_seg["obs_count"]),
                },
            )
            self._attach_evidence(edge_support, pair, "transition", evidence)

        for pair, switches in pair_switches.items():
            if len(switches) < 2:
                continue
            evidence = self._make_evidence(
                "repeated_crossing",
                score=min(1.0, float(len(switches) - 1) / 2.0),
                step_start=int(switches[0][0]["frame_end"]),
                step_end=int(switches[-1][1]["frame_start"]),
                source_ref="stable_room_segments",
                notes="same room pair crossed repeatedly in debounced trajectory history",
                metadata={"crossing_count": int(len(switches))},
            )
            self._attach_evidence(edge_support, pair, "transition", evidence)

    def _collect_vertical_transition_support(
        self,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
        world: Dict[str, Any],
        room_lookup: Dict[str, Dict[str, Any]],
    ) -> None:
        pair_events: Dict[Tuple[str, str], List[Dict[str, Any]]] = {}
        for item in world.get("vertical_transitions", []):
            room_a = _canonical_room_id(item.get("from_room_id"))
            room_b = _canonical_room_id(item.get("to_room_id"))
            if room_a is None or room_b is None or room_a == room_b:
                continue
            if room_a not in room_lookup or room_b not in room_lookup:
                continue
            if room_lookup[room_a].get("floor_id") == room_lookup[room_b].get("floor_id"):
                continue
            pair = tuple(sorted((room_a, room_b)))
            pair_events.setdefault(pair, []).append(dict(item))

        for pair, events in pair_events.items():
            score = min(1.0, max(float(event.get("confidence", 0.0)) for event in events))
            evidence = self._make_evidence(
                "vertical_transition_observation",
                score=score,
                step_start=min(int(event.get("frame_start", 0)) for event in events),
                step_end=max(int(event.get("frame_end", 0)) for event in events),
                source_ref=",".join(str(event.get("transition_id", "vt")) for event in events),
                notes="explicit cross-floor room transition exported by the world model",
                metadata={
                    "transition_count": int(len(events)),
                    "from_floor_ids": sorted({str(event.get("from_floor_id")) for event in events}),
                    "to_floor_ids": sorted({str(event.get("to_floor_id")) for event in events}),
                },
            )
            self._attach_evidence(edge_support, pair, "vertical_transition", evidence)

    def _promote_possible_connections(
        self,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
    ) -> None:
        for pair, relation_map in edge_support.items():
            adjacent_payload = relation_map.get("adjacent")
            transition_payload = relation_map.get("transition")
            if transition_payload is not None:
                continue
            if adjacent_payload is None:
                continue
            adjacent_conf = self._aggregate_confidence(adjacent_payload["evidence_records"])
            if adjacent_conf >= float(self.status_thresholds["supported"]):
                continue
            relation_map.setdefault("possible_connection", {"evidence_records": [], "metadata": {}})
            fallback_payload = relation_map["possible_connection"]
            if fallback_payload["evidence_records"]:
                continue
            for evidence in adjacent_payload["evidence_records"]:
                if evidence.evidence_type not in {"boundary_contact", "shared_frontier"}:
                    continue
                fallback_payload["evidence_records"].append(evidence)
            fallback_payload["metadata"].update(
                {
                    "reason": "adjacent evidence is still weak, so expose as queryable possible_connection",
                }
            )

    def _stable_room_segments(self, transition_history: Sequence[Dict[str, Any]]) -> List[Dict[str, Any]]:
        observations = []
        for item in sorted(transition_history, key=lambda row: (int(row.get("frame_idx", 0)), float(row.get("timestamp", 0.0)))):
            room_id = _canonical_room_id(item.get("current_room_id"))
            observations.append(
                {
                    "frame_idx": int(item.get("frame_idx", 0)),
                    "timestamp": float(item.get("timestamp", 0.0)),
                    "room_id": room_id,
                }
            )
        if not observations:
            return []

        segments: List[Dict[str, Any]] = []
        for obs in observations:
            if not segments or segments[-1]["room_id"] != obs["room_id"]:
                segments.append(
                    {
                        "room_id": obs["room_id"],
                        "frame_start": int(obs["frame_idx"]),
                        "frame_end": int(obs["frame_idx"]),
                        "timestamp_start": float(obs["timestamp"]),
                        "timestamp_end": float(obs["timestamp"]),
                        "obs_count": 1,
                    }
                )
                continue
            segments[-1]["frame_end"] = int(obs["frame_idx"])
            segments[-1]["timestamp_end"] = float(obs["timestamp"])
            segments[-1]["obs_count"] += 1

        jitter_tolerance = int(self.config["room_switch_jitter_tolerance"])
        changed = True
        while changed and len(segments) >= 3:
            changed = False
            merged: List[Dict[str, Any]] = []
            idx = 0
            while idx < len(segments):
                if 0 < idx < len(segments) - 1:
                    left = segments[idx - 1]
                    current = segments[idx]
                    right = segments[idx + 1]
                    if (
                        current["obs_count"] <= jitter_tolerance
                        and left["room_id"] == right["room_id"]
                    ):
                        left["frame_end"] = right["frame_end"]
                        left["timestamp_end"] = right["timestamp_end"]
                        left["obs_count"] += current["obs_count"] + right["obs_count"]
                        idx += 2
                        changed = True
                        continue
                merged.append(segments[idx])
                idx += 1
            segments = merged
        return [segment for segment in segments if segment["room_id"] is not None]

    def _make_evidence(
        self,
        evidence_type: str,
        score: float,
        step_start: int,
        step_end: int,
        source_ref: str,
        notes: str = "",
        metadata: Optional[Dict[str, Any]] = None,
    ) -> EvidenceRecord:
        evidence = EvidenceRecord(
            evidence_id=f"ev_{self._evidence_counter:05d}",
            evidence_type=str(evidence_type),
            score=_clamp01(score),
            step_start=int(step_start),
            step_end=int(step_end),
            source_ref=str(source_ref),
            notes=str(notes),
            metadata=dict(metadata or {}),
        )
        self._evidence_counter += 1
        return evidence

    def _attach_evidence(
        self,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
        pair: Tuple[str, str],
        relation_type: str,
        evidence: EvidenceRecord,
    ) -> None:
        relation_payload = edge_support.setdefault(pair, {}).setdefault(
            relation_type,
            {
                "evidence_records": [],
                "metadata": {},
            },
        )
        relation_payload["evidence_records"].append(evidence)

    def _aggregate_confidence(self, evidence_records: Sequence[EvidenceRecord]) -> float:
        confidence = 0.0
        for evidence in evidence_records:
            weight = float(self.evidence_weights.get(evidence.evidence_type, 0.0))
            confidence += weight * float(evidence.score)
        return _clamp01(confidence)

    def _materialize_edges(
        self,
        topology: RoomTopology,
        edge_support: Dict[Tuple[str, str], Dict[str, Dict[str, Any]]],
    ) -> None:
        for pair, relation_map in sorted(edge_support.items()):
            room_a, room_b = pair
            for relation_type, payload in sorted(relation_map.items()):
                evidence_records = list(payload.get("evidence_records", []))
                if not evidence_records:
                    continue
                confidence = self._aggregate_confidence(evidence_records)
                status = _status_from_confidence(confidence, self.status_thresholds)
                evidence_ids = [record.evidence_id for record in evidence_records]
                first_seen = min(int(record.step_start) for record in evidence_records)
                last_seen = max(int(record.step_end) for record in evidence_records)
                metadata = dict(payload.get("metadata", {}))
                metadata.setdefault(
                    "evidence_type_breakdown",
                    {
                        evidence_type: sum(1 for record in evidence_records if record.evidence_type == evidence_type)
                        for evidence_type in sorted({record.evidence_type for record in evidence_records})
                    },
                )
                edge_attrs = {
                    "relation_type": relation_type,
                    "confidence": _round_float(confidence),
                    "status": status,
                    "support_count": len(evidence_records),
                    "first_seen_step": first_seen,
                    "last_seen_step": last_seen,
                    "evidence_ids": evidence_ids,
                    "metadata": metadata,
                    "source_room_id": room_a,
                    "target_room_id": room_b,
                }
                for evidence in evidence_records:
                    topology.evidences[evidence.evidence_id] = evidence.to_dict()
                topology.graph.add_edge(room_a, room_b, **edge_attrs)
                topology.graph.add_edge(room_b, room_a, **dict(edge_attrs, source_room_id=room_b, target_room_id=room_a))
